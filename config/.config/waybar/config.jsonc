{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 4,

  "modules-left": ["custom/launcher", "hyprland/window"],
  "modules-center": ["memory", "hyprland/workspaces", "cpu"],
  "modules-right": [
    "tray",
    "pulseaudio",
    "temperature",
    "custom/update",
    "backlight",
    "network",
    "idle_inhibitor",
    "battery",
    "clock",
    "custom/power"
  ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "persistent-workspaces": {
      "*": [1, 2, 3, 4, 5]
    },
    "format-icons": {
      "active": "󰮯",
      "default": "󰊠"
    }
  },

  "custom/launcher": {
    "format": "   ",
    "on-click": "fuzzel",
    "tooltip-format": "Launch applications"
  },

  "custom/update": {
    "format": " {}",
    "exec": "checkupdates | wc -l",
    "interval": 1200, // Check every 30 minutes
    "exec-if": "exit 0", // Always run the command
    "on-click": "kitty -e paru -Syyu", // Example: run an update command in a terminal on click
    "signal": 8 // Can be updated manually with pkill -SIGRTMIN+8 waybar
  },

  "hyprland/window": {
    "format": "{title}",
    "max-length": 55,
    "rewrite": {
      "": "Hyprland",
      "(.*) — Mozilla Firefox": "󰈹 Firefox",
      "(.*) - Alacritty": "❯ Terminal"
    }
  },

  "clock": {
    "format": "󱑂 {:%H:%M}",
    "format-alt": "󰃭 {:%Y-%m-%d}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>"
  },

  "network": {
    "format-wifi": "󰖩 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰖪 Disconnected",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    "on-click": "alacritty -e /usr/bin/gazelle"
  },

  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": " ",
      "deactivated": " "
    }
  },

  "cpu": {
    "format": " {usage}%",
    "interval": 10,
    "on-click": "alacritty -e btop"
  },

  "memory": {
    "format": " {}%",
    "interval": 10,
    "on-click": "kitty -e htop"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "format-icons": {
      "headphone": "󰋋",
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}{capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "",
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
  },

  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", ""]
  },

  "backlight": {
    // "device": "acpi_video1",
    "format": "{icon} {percent}%",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },

  "custom/power": {
    "tooltip": true,
    "format": " ",
    "tooltip-format": "Power menu",
    "on-click": "bash -lc 'choice=$(printf \" Shutdown\\n Reboot\\n Cancel\" | fuzzel --dmenu --hide-prompt --lines 3); case \"$choice\" in \" Shutdown\") systemctl poweroff ;; \" Reboot\") systemctl reboot ;; *) : ;; esac'"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  }
}
